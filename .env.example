# AlgoForge - Firebase Configuration
# Copy this file to .env and fill in the values from your Firebase Console
# (Project Settings > General > Your apps > Web app > SDK setup and configuration)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=algoforge-12831.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=algoforge-12831
VITE_FIREBASE_STORAGE_BUCKET=algoforge-12831.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
